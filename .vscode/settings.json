{
  "[markdown]": {
    "editor.quickSuggestions": {
      "comments": "on",
      "other": "on",
      "strings": "on"
    },
    "editor.wordWrap": "on"
  },
  "dotenv.enableAutocloaking": false,
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.codeActionsOnSave.rules": ["!@typescript-eslint/no-unsafe-*"],
  "eslint.lintTask.enable": true,
  "eslint.useESLintClass": true,
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [
    {
      "pattern": "apps/*/"
    },
    {
      "pattern": "packages/*/"
    }
  ],
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.js": "${capture}.test.js, ${capture}.spec.js, ${capture}.js.map",
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.d.ts, ${capture}.ts.map",
    "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.tsx.map",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc",
    "tsconfig.json": "tsconfig.*.json"
  },
  "explorerExclude.backup": {},
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.nx": false,
    "**/.svn": true,
    "**/*.tsbuildinfo": true,
    "**/coverage": true,
    "**/CVS": true,
    "**/dist": false,
    "**/out": false,
    "**/Thumbs.db": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/documentation/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/public/build/**": true
  },
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "js/ts.implicitProjectConfig.checkJs": true,
  "js/ts.implicitProjectConfig.experimentalDecorators": true,
  "js/ts.implicitProjectConfig.module": "ESNext",
  "js/ts.implicitProjectConfig.target": "ESNext",
  "json.format.keepLines": true,
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["./nx.json"],
      "url": "node_modules/nx/schemas/nx-schema.json"
    },
    {
      "fileMatch": ["**/project.json"],
      "url": "node_modules/nx/schemas/project-schema.json"
    },
    {
      "fileMatch": ["**/workspace.json"],
      "url": "node_modules/nx/schemas/workspace-schema.json"
    },
    {
      "fileMatch": ["**/tsconfig.*.json", "**/tsconfig.json", "config/typescript/*.json"],
      "url": "https://json.schemastore.org/tsconfig"
    }
  ],
  "markdown.preview.breaks": true,
  "markdown.preview.linkify": true,
  "nxConsole.generateAiAgentRules": true,
  "peacock.color": "#2f263f",
  "prettier.configPath": "./prettier.config.js",
  "search.exclude": {
    "**/.*": true,
    "**/bower_components": true,
    "**/build": true,
    "**/coverage": true,
    "**/dist": true,
    "**/documentation": true,
    "**/node_modules": true
  },
  "typescript.check.npmIsInstalled": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.autoImportFileExcludePatterns": [
    "@radix-ui/**",
    "node:console",
    "node:stream/consumers",
    "node:test",
    "react-router-dom"
  ],
  "typescript.preferences.importModuleSpecifier": "shortest",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.nodePath": "node",
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": [
      "**/node_modules/**/*",
      "**/build/**/*",
      "**/dist/**/*",
      "**/out/**/*",
      "**/coverage/**/*",
      "**/documentation/**/*",
      "**/public/build/**/*"
    ],
    "watchDirectory": "useFsEvents",
    "watchFile": "useFsEvents"
  },
  "typescript.tsserver.web.projectWideIntellisense.suppressSemanticErrors": false,
  "typescript.tsserver.web.typeAcquisition.enabled": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.workspaceSymbols.excludeLibrarySymbols": false,
  "typescript.workspaceSymbols.scope": "allOpenProjects",
  "vitest.experimentalStaticAstCollect": true,
  "vitest.filesWatcherInclude": "**/src/**/*.{ts|tsx}",
  "vitest.shellType": "terminal",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#47395f",
    "activityBar.background": "#47395f",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#000000",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#47395f",
    "statusBar.background": "#2f263f",
    "statusBar.foreground": "#e7e7e7",
    "statusBar.noFolderBackground": "#007acc",
    "statusBarItem.hoverBackground": "#47395f",
    "statusBarItem.remoteBackground": "#2f263f",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#2f263f",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#2f263f99",
    "titleBar.inactiveForeground": "#e7e7e799"
  }
}
