{
  "author": "",
  "bin": {
    "typescript-viewer": "dist/bin/typescript-viewer.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@duckdb/node-api": "1.4.1-r.2",
    "@types/dagre": "^0.7.53",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.47.0",
    "apache-arrow": "^21.1.0",
    "ast-types": "^0.16.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "jscodeshift": "^17.3.0",
    "mermaid": "^11.12.0",
    "ora": "^9.0.0",
    "pinia": "^3.0.3",
    "read-package-up": "^11.0.0",
    "read-pkg": "^9.0.1",
    "recast": "^0.23.11",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "uuid": "^13.0.0",
    "vue": "^3.5.22"
  },
  "description": "TypeScript codebase visualization tool",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.8.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.24.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.10",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue-tsc": "^3.1.1"
  },
  "keywords": [
    "typescript",
    "visualization",
    "dependency-graph",
    "analysis"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "name": "magus-typescript-viewer",
  "scripts": {
    "analyze": "node dist/bin/typescript-viewer.js analyze",
    "build": "pnpm typecheck && vite build && node ./esbuild.config.js",
    "dev": "pnpm run --filter magus-typescript-viewer --parallel \"/^dev:.*/\"",
    "dev:server": "source .env && nodemon --watch src/server --watch src/server.ts --watch src/server/db --exec 'tsx' src/server.ts",
    "dev:ui": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "serve": "node dist/bin/typescript-viewer.js serve",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
