    "@duckdb/node-api": "1.3.2-alpha.26",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@xyflow/react": "^12.8.4",
    "@xyflow/system": "^0.0.68",
    "apache-arrow": "^21.0.0",
    "ast-types": "^0.16.1",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "elkjs": "^0.10.0",
    "jscodeshift": "^17.3.0",
    "mermaid": "^11.10.1",
    "ora": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-package-up": "^11.0.0",
    "read-pkg": "^9.0.1",
    "recast": "^0.23.11",
    "tsx": "^4.20.5",
    "typescript": "5.9.2",
    "uuid": "^11.1.0"
  },
  "description": "TypeScript codebase visualization tool",
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "nodemon": "^3.1.10",
    "vite": "^7.1.3",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-node-polyfills": "^0.24.0"
  },
  "keywords": [
    "typescript",
    "visualization",
    "dependency-graph",
    "analysis"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "name": "magus-typescript-viewer",
  "scripts": {
    "analyze": "node dist/bin/typescript-viewer.js analyze",
    "build": "pnpm typecheck && vite build && node ./esbuild.config.js",
    "dev": "pnpm run --filter magus-typescript-viewer --parallel \"/^dev:.*/\"",
    "dev:server": "nodemon --watch src/db --exec 'tsx' src/server.ts",
    "dev:ui": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "serve": "node dist/bin/typescript-viewer.js serve",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
