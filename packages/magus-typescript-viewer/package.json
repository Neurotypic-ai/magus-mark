{
  "author": "",
  "bin": {
    "typescript-viewer": "dist/bin/typescript-viewer.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@duckdb/node-api": "1.3.2-alpha.26",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.42.3",
    "apache-arrow": "^21.0.0",
    "ast-types": "^0.16.1",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "elkjs": "^0.10.0",
    "jscodeshift": "^17.3.0",
    "mermaid": "^11.10.1",
    "ora": "^8.2.0",
    "pinia": "^2.2.8",
    "read-package-up": "^11.0.0",
    "read-pkg": "^9.0.1",
    "recast": "^0.23.11",
    "tsx": "^4.20.5",
    "typescript": "5.9.2",
    "uuid": "^11.1.0",
    "vue": "^3.5.13"
  },
  "description": "TypeScript codebase visualization tool",
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.3",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue-tsc": "^2.1.10"
  },
  "keywords": [
    "typescript",
    "visualization",
    "dependency-graph",
    "analysis"
  ],
  "license": "ISC",
  "main": "dist/index.js",
  "name": "magus-typescript-viewer",
  "scripts": {
    "analyze": "node dist/bin/typescript-viewer.js analyze",
    "build": "pnpm typecheck && vite build && node ./esbuild.config.js",
    "dev": "pnpm run --filter magus-typescript-viewer --parallel \"/^dev:.*/\"",
    "dev:server": "nodemon --watch src/db --exec 'tsx' src/server.ts",
    "dev:ui": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "serve": "node dist/bin/typescript-viewer.js serve",
    "typecheck": "vue-tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
