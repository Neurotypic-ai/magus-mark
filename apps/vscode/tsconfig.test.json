{
  "compilerOptions": {
    "outDir": "dist/test",
    "rootDir": "src",
    "noEmit": false,
    "module": "CommonJS",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "verbatimModuleSyntax": false,
    "noEmitOnError": false,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/test/**/*.ts",
    "src/tests/**/*.ts",
    "src/types/**/*.ts",
    "src/views/**/*.ts",
    "src/services/**/*.ts",
    "src/cursor/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "esbuild.config.ts", "src/extension.ts"]
}

